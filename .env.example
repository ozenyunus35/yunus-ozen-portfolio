# Copy to .env.local for local GitHub Pages preview builds.
# Leave both empty for normal development (http://localhost:3000).

# Repository subpath on GitHub Pages project sites.
NEXT_PUBLIC_BASE_PATH=/yunus-ozen-portfolio

# Public site origin used in metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://ozenyunus35.github.io/yunus-ozen-portfolio

# Set automatically during `next build` when the CV file exists in public/documents/.
# Do not set manually unless you know what you are doing.
# NEXT_PUBLIC_CV_AVAILABLE=
